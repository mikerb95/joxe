{
  "rewrites": [
    {
      "source": "/admin/payment",
      "destination": "/Payment.html"
    },
    {
      "source": "/admin",
      "destination": "/Admin.html"
    },
    {
      "source": "/staff",
      "destination": "/Staff.html"
    },
    {
      "source": "/agenda",
      "destination": "/Agenda.html"
    },
    {
      "source": "/portal",
      "destination": "/Portal.html"
    },
    {
      "source": "/booking",
      "destination": "/Booking.html"
    },
    {
      "source": "/checkin",
      "destination": "/CheckIn.html"
    },
    {
      "source": "/scan",
      "destination": "/Scan.html"
    },
    {
      "source": "/lobby",
      "destination": "/Lobby.html"
    },
    {
      "source": "/cuenta",
      "destination": "/Cuenta.html"
    },
    {
      "source": "/showcase",
      "destination": "/Showcase.html"
    },
    {
      "source": "/",
      "destination": "/Asesores de Imagen.html"
    }
  ],
  "functions": {
    "api/crm.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/client.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.jsx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
