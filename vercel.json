{
  "rewrites": [
    {
      "source": "/api/admin",
      "destination": "/api/ops?_ep=admin"
    },
    {
      "source": "/api/backup",
      "destination": "/api/ops?_ep=backup"
    },
    {
      "source": "/api/crm",
      "destination": "/api/ops?_ep=crm"
    },
    {
      "source": "/api/payment",
      "destination": "/api/ops?_ep=payment"
    },
    {
      "source": "/api/push",
      "destination": "/api/ops?_ep=push"
    },
    {
      "source": "/api/reminders",
      "destination": "/api/ops?_ep=reminders"
    },
    {
      "source": "/api/work-hours",
      "destination": "/api/ops?_ep=work-hours"
    },
    {
      "source": "/admin/payment",
      "destination": "/Payment.html"
    },
    {
      "source": "/admin",
      "destination": "/Admin.html"
    },
    {
      "source": "/staff",
      "destination": "/Staff.html"
    },
    {
      "source": "/agenda",
      "destination": "/Agenda.html"
    },
    {
      "source": "/portal",
      "destination": "/Portal.html"
    },
    {
      "source": "/booking",
      "destination": "/Booking.html"
    },
    {
      "source": "/checkin",
      "destination": "/CheckIn.html"
    },
    {
      "source": "/scan",
      "destination": "/Scan.html"
    },
    {
      "source": "/lobby",
      "destination": "/Lobby.html"
    },
    {
      "source": "/cuenta",
      "destination": "/Cuenta.html"
    },
    {
      "source": "/resena",
      "destination": "/Resena.html"
    },
    {
      "source": "/showcase",
      "destination": "/Showcase.html"
    },
    {
      "source": "/academia",
      "destination": "/Academia.html"
    },
    {
      "source": "/",
      "destination": "/Asesores de Imagen.html"
    }
  ],
  "functions": {
    "api/client.js": {
      "maxDuration": 10
    },
    "api/ops.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.jsx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
