# Turso Database
# Obtén estos valores desde: https://app.turso.tech
# 1. Crea una base de datos (ej: joxe-db)
# 2. Crea un token de autenticación
# 3. Copia los valores aquí y en Vercel > Settings > Environment Variables

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Web Push (notificaciones) — VAPID
# Genera el par con:  npx web-push generate-vapid-keys
# Pega la salida aquí y en Vercel > Settings > Environment Variables (Production + Preview).
# VAPID_SUBJECT debe ser un mailto: o una URL https://
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:tucorreo@dominio.comconfigurar


